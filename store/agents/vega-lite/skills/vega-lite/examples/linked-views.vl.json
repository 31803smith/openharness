  "hconcat": [
    {
      "width": 440,
      "height": 280,
      "params": [
        {
          "name": "brush",
          "select": {
            "type": "interval"
          }
        },
        {
          "name": "zoom",
          "select": {
            "type": "interval",
            "encodings": [
              "x",
              "y"
            ],
            "on": "[mousedown[event.shiftKey], window:mouseup] > window:mousemove!",
            "translate": "[mousedown[event.shiftKey], window:mouseup] > window:mousemove!"
          },
          "bind": "scales"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 100,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "distance",
          "type": "quantitative",
          "axis": {
            "title": "Trip distance (km)"
          }
        },
        "y": {
          "field": "cycling",
          "type": "quantitative",
          "axis": {
            "title": "Cycling share (%)"
          }
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "legend": {
            "orient": "top"
          }
        },
        "opacity": {
          "condition": {
            "param": "brush",
            "value": 0.9
          },
          "value": 0.2
        }
      }
    },
    {
      "width": 220,
      "height": 280,
      "transform": [
        {
          "filter": {
            "param": "brush"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "region",
          "type": "nominal",
          "axis": {
            "title": null,
            "labelAngle": 0
          }
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "axis": {
            "title": "Selected cities"
          }
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "legend": {
            "orient": "top"
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 14,
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "title": {
      "anchor": "start",
      "fontSize": 22,
      "fontWeight": 500,
      "offset": 20
    },
    "range": {
